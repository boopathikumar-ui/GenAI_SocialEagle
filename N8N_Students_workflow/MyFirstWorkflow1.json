      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Get the AI response\nlet response = $json.text || $json.output || \"\";\n\n// Remove ```json and ``` if AI added them\nresponse = response\n  .replace(\"```json\", \"\")\n  .replace(\"```\", \"\")\n  .trim();\n\n// Convert AI response from text to JSON\nlet student = JSON.parse(response);\n\n// Return cleaned student data\nreturn {\n  json: {\n    Name: student.Name,\n    Email: student.Email,\n    Phone: student.Phone,\n    Course: student.Course,\n    Fee_Paid: student.Fee_Paid,\n    City: student.City,\n    Enrolled_Date: student.Enrolled_Date\n  }\n};"
