# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://user:password@localhost:5432/team14_roast
# REQUIRED: 32+ random chars. Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ANTHROPIC_API_KEY=
ROAST_MODEL=claude-haiku-4-5-20251001
GITHUB_TOKEN=
# Which backend writes the roasts: anthropic | openai | fake
# "fake" serves canned dev output; the app refuses to start with it unless DEBUG=true.
ROAST_PROVIDER=anthropic
OPENAI_API_KEY=
OPENAI_ROAST_MODEL=gpt-4o-mini
ROAST_DAILY_PER_IP_CAP=30
ROAST_DAILY_GLOBAL_CAP=1000
# Optional explicit Google OAuth redirect URI (else derived from the request)
GOOGLE_REDIRECT_URI=
# Proxy IPs whose X-Forwarded-* headers uvicorn trusts (set to your reverse proxy / LB)
FORWARDED_ALLOW_IPS=127.0.0.1
VITE_API_URL=http://localhost:8000

# docker-compose postgres service (DATABASE_URL is derived from these inside compose)
POSTGRES_USER=user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=team14_roast
